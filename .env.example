# Environment for rabbithole. Copy to .env (gitignored) and fill in.
#
# Not read automatically. Source it yourself:
#
#   set -a; source .env; set +a      a shell
#   EnvironmentFile=/etc/rabbithole/env    a systemd unit
#
# `make serve`, `make ingest` and the other targets pick up ./.env on their own.

# Password for the Postgres store, used when configs/config.yaml sets store.url.
# Keeps the password out of the config file and out of the web config viewer.
# Ignored when the store is SQLite (store.db_path).
RABBITHOLE_DB_PASSWORD=hunter2
